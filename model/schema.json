{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smart-learning.local/schema/model-2.0.json",
  "title": "智慧学伴学情分析模型 v2.0",
  "type": "object",
  "required": [
    "schema_version", "project", "generated_at", "config", "definitions",
    "mindmap", "points", "classes", "students", "attention_students",
    "warnings", "teaching_advice", "comparison", "data_quality"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "project": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "meta": {"type": "object"},
    "config": {
      "type": "object",
      "required": ["baseline_error_rate", "warning_top_n", "tiers", "mastery"],
      "properties": {
        "baseline_error_rate": {"type": "number", "minimum": 0, "maximum": 1},
        "warning_top_n": {"type": "integer", "minimum": 1},
        "tiers": {"type": "array", "items": {"type": "object"}},
        "mastery": {"type": "object"},
        "attention": {"type": "object"}
      }
    },
    "definitions": {"type": "object"},
    "mindmap": {
      "type": "object",
      "required": ["canvas", "legend", "themes", "nodes", "edges"],
      "properties": {
        "canvas": {"type": "object", "required": ["width", "height"]},
        "legend": {"type": "array"},
        "themes": {"type": "array"},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name", "kind", "type", "x", "y"],
            "properties": {
              "id": {"type": "string"},
              "name": {"type": "string"},
              "kind": {"enum": ["point", "foundation"]},
              "type": {"type": "string"},
              "x": {"type": "number"},
              "y": {"type": "number"},
              "error_rate": {"type": "number"},
              "tier": {"type": "string"},
              "parent_id": {"type": ["string", "null"]},
              "parent_name": {"type": "string"}
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "kind"],
            "properties": {
              "from": {"type": "string"},
              "to": {"type": "string"},
              "kind": {"enum": ["main", "cross", "foundation"]}
            }
          }
        }
      }
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "theme", "tags", "primary_type", "importance", "error_rate", "tier", "parent_id", "parent_name"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "theme": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "primary_type": {"enum": ["记忆型", "逻辑型"]},
          "importance": {"type": "string"},
          "attempts": {"type": "integer", "minimum": 0},
          "score": {"type": "number", "minimum": 0},
          "full": {"type": "number", "minimum": 0},
          "score_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "error_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "mastery": {"enum": ["掌握", "部分掌握", "未掌握", "数据不足"]},
          "rank": {"type": "integer", "minimum": 1},
          "tier": {"enum": ["重点", "次重点", "注意点"]},
          "parent_id": {"type": ["string", "null"]},
          "parent_name": {"type": "string"},
          "class_rates": {"type": "object"}
        }
      }
    },
    "classes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "student_count", "avg_student_rate", "pass_rate", "excellent_rate", "points", "warnings", "teaching_advice"],
        "properties": {
          "id": {"type": "string"},
          "student_count": {"type": "integer"},
          "avg_student_rate": {"type": "number"},
          "pass_rate": {"type": "number"},
          "excellent_rate": {"type": "number"},
          "points": {"type": "array"},
          "warnings": {"type": "array"},
          "teaching_advice": {"type": "object"}
        }
      }
    },
    "students": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "class", "score_rate", "error_rate", "weak_points", "warnings", "advice_summary"],
        "properties": {
          "id": {"type": "string"},
          "class": {"type": "string"},
          "score_rate": {"type": "number"},
          "error_rate": {"type": "number"},
          "class_rank": {"type": "integer"},
          "class_size": {"type": "integer"},
          "mastery_counts": {"type": "object"},
          "points": {"type": "array"},
          "weak_points": {"type": "array", "maxItems": 3},
          "strong_points": {"type": "array"},
          "advice_summary": {"type": "string"},
          "warnings": {"type": "array", "maxItems": 3}
        }
      }
    },
    "attention_students": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "class", "weak_count", "level"],
        "properties": {
          "id": {"type": "string"},
          "class": {"type": "string"},
          "weak_count": {"type": "integer"},
          "level": {"enum": ["高", "中", "低"]},
          "attention_rank": {"type": "integer"}
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["rank", "point_id", "point_name", "error_rate", "parent_id", "parent_name", "student_text", "teacher_text"],
        "properties": {
          "rank": {"type": "integer"},
          "point_id": {"type": "string"},
          "point_name": {"type": "string"},
          "error_rate": {"type": "number"},
          "parent_id": {"type": ["string", "null"]},
          "parent_name": {"type": "string"},
          "parent_external": {"type": "boolean"},
          "reason": {"type": "string"},
          "student_text": {"type": "string"},
          "teacher_text": {"type": "string"},
          "action": {"type": "string"}
        }
      }
    },
    "teaching_advice": {
      "type": "object",
      "required": ["sample_size", "top_modules", "paragraph", "actions"],
      "properties": {
        "sample_size": {"type": "integer"},
        "top_modules": {"type": "array"},
        "paragraph": {"type": "string"},
        "actions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "comparison": {
      "type": "object",
      "required": ["classes", "points"],
      "properties": {
        "classes": {"type": "array", "items": {"type": "string"}},
        "points": {"type": "array"}
      }
    },
    "data_quality": {
      "type": "object",
      "required": ["responses", "students", "classes", "points", "coverage"],
      "properties": {
        "responses": {"type": "integer"},
        "students": {"type": "integer"},
        "classes": {"type": "integer"},
        "points": {"type": "integer"},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
